{
  "server": {
    "host": "0.0.0.0",
    "port": 8080
  },
  "auth": {
    "mode": "header",
    "headerPrefix": "x-fieldscope-"
  },
  "connectors": [
    {
      "id": "jira-prod",
      "name": "Enterprise Jira",
      "protocol": "http",
      "baseUrl": "${JIRA_BASE_URL:-https://jira.example.com}",
      "auth": {
        "type": "bearer",
        "token": "${JIRA_API_TOKEN:-demo-jira-service-token}"
      },
      "mcpTools": [
        {
          "name": "jira_search_issues",
          "description": "Search enterprise Jira issues scoped to the user's project",
          "method": "GET",
          "path": "/rest/api/3/search",
          "inputSchema": {
            "type": "object",
            "properties": {
              "project": { "type": "string", "description": "Jira project key" },
              "maxResults": { "type": "number", "description": "Maximum issues to return (<= 50)" }
            }
          }
        },
        {
          "name": "jira_delete_issue",
          "description": "Permanently delete a Jira issue (admin only)",
          "method": "DELETE",
          "path": "/rest/api/3/issue/:issueKey",
          "inputSchema": {
            "type": "object",
            "required": ["issueKey"],
            "properties": {
              "issueKey": { "type": "string" }
            }
          }
        }
      ]
    }
  ],
  "policies": [
    {
      "id": "policy-jira-eng-read",
      "name": "Engineering Read Jira Issues (HTTP)",
      "effect": "allow",
      "priority": 100,
      "match": {
        "principal": {
          "roles": ["employee"],
          "attributes": {
            "department": "engineering"
          }
        },
        "connector": "jira-prod"
      },
      "action": {
        "protocol": "http",
        "methods": ["GET"],
        "paths": ["/rest/api/3/search", "/rest/api/3/issue/*"]
      },
      "request": {
        "validate": [
          {
            "expr": "query.maxResults == null || query.maxResults <= 50",
            "message": "单次最多查询 50 条工单（maxResults <= 50）"
          }
        ],
        "enforce": {
          "query.project": "{{ principal.attributes.projectKey }}"
        }
      },
      "response": {
        "mode": "allowlist",
        "fields": [
          "issues[*].key",
          "issues[*].fields.summary",
          "issues[*].fields.status.name",
          "issues[*].fields.reporter.displayName",
          "issues[*].fields.reporter.emailAddress",
          "issues[*].fields.description"
        ],
        "transforms": [
          {
            "path": "issues[*].fields.reporter.emailAddress",
            "action": "mask_email"
          },
          {
            "path": "issues[*].fields.description",
            "action": "redact_pii"
          }
        ]
      }
    },
    {
      "id": "policy-jira-eng-mcp-read",
      "name": "Engineering Read Jira Issues (MCP)",
      "effect": "allow",
      "priority": 100,
      "match": {
        "principal": {
          "roles": ["employee"],
          "attributes": {
            "department": "engineering"
          }
        },
        "connector": "jira-prod"
      },
      "action": {
        "protocol": "mcp",
        "tools": ["jira_search_*"]
      },
      "request": {
        "validate": [
          {
            "expr": "args.maxResults == null || args.maxResults <= 50",
            "message": "单次最多查询 50 条工单（maxResults <= 50）"
          }
        ],
        "enforce": {
          "args.project": "{{ principal.attributes.projectKey }}"
        }
      },
      "response": {
        "mode": "allowlist",
        "fields": [
          "issues[*].key",
          "issues[*].fields.summary",
          "issues[*].fields.status.name",
          "issues[*].fields.reporter.displayName",
          "issues[*].fields.reporter.emailAddress",
          "issues[*].fields.description"
        ],
        "transforms": [
          {
            "path": "issues[*].fields.reporter.emailAddress",
            "action": "mask_email"
          },
          {
            "path": "issues[*].fields.description",
            "action": "redact_pii"
          }
        ]
      }
    },
    {
      "id": "policy-deny-all-deletes",
      "name": "Deny All Delete Operations",
      "effect": "deny",
      "priority": 999,
      "match": {
        "principal": {},
        "connector": "*"
      },
      "action": {
        "protocol": "http",
        "methods": ["DELETE"],
        "paths": ["/**"]
      }
    }
  ]
}
